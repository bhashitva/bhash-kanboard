आयात मानक.असमवेबचालक;
आयात मानक.वेब;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.पाठ्य;
आयात मानक.वेबत्रुटि;
आयात मानक.सत्रप्रबंधक;
आयात मानक.निरस्तीकरणचिह्न;

फलन चलअंक(मूल: मानचित्र<पाठ,सर्ववस्तु>, कुंजी: पाठ, न्यूनतम: पूर्णांक) -> पूर्णांक {
    यदि (!मूल.है(कुंजी) || !प्रकारहै<पूर्णांक>(मूल[कुंजी])) { फेंको नया वेबत्रुटि(४२२,"पूर्णांक क्षेत्र चाहिए।"); }
    स्थिर अंक: पूर्णांक=परिवर्तित<पूर्णांक>(मूल[कुंजी]);
    यदि (अंक<न्यूनतम || अंक>२१४७४८३६४७) { फेंको नया वेबत्रुटि(४२२,"पूर्णांक सीमा से बाहर है।"); }
    लौटाओ अंक;
}

वर्ग पटचालक पालन असमवेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान भंडार: पटभंडार;
    निजी मान घटनाएँ: पटघटनाएँ;
    निजी मान सदस्य: सदस्यभंडार;

    निर्माता(म: सत्रप्रबंधक, भंडार: पटभंडार, घटनाएँ: पटघटनाएँ, सदस्य: सदस्यभंडार) {
        यह.म=म; यह.भंडार=भंडार; यह.घटनाएँ=घटनाएँ; यह.सदस्य=सदस्य;
    }

    सार्वजनिक असमकालिक फलन संभालो(अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर पट: पाठ=अ.पथमान["board"];
        स्थिर नाम: पाठ=म.अधिकृत(अ,"member").उपयोगकर्ता();
        स्थिर भूमिका: पाठ=प्रतीक्षा सदस्य.भूमिका(पट,नाम,चिह्न);
        स्थिर पढ़ना: तार्किक=अ.विधि=="GET" || अ.विधि=="HEAD";
        यदि (भूमिका=="" || (!पढ़ना && !संपादनमान्य(भूमिका))) {
            फेंको नया वेबत्रुटि(४०३,"यह कार्यपट उपलब्ध नहीं है।");
        }
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        स्थिर प्रति: पटप्रति=प्रतीक्षा भंडार.प्रतिलो(पट,चिह्न);
        मान स्थिति: पूर्णांक=२००;
        यदि (पढ़ना) {
            म.अधिकृत(अ,"member");
            यदि ((प्रतीक्षा सदस्य.भूमिका(पट,नाम,चिह्न))=="") { फेंको नया वेबत्रुटि(४०३,"यह कार्यपट उपलब्ध नहीं है।"); }
            फल["board"]=पट; फल["name"]=प्रति.नाम; फल["revision"]=प्रति.संस्करण;
            फल["lanes"]=प्रति.पंक्तियाँ; फल["archived"]=प्रति.अभिलेखित;
        } अन्यथा {
            स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
            स्थिर संस्करण: पूर्णांक=चलअंक(मूल,"revision",०);
            यदि (प्रति.संस्करण!=संस्करण || संस्करण==२१४७४८३६४७) {
                फेंको नया वेबत्रुटि(४०९,"कार्यपट का संस्करण बदल गया है।");
            }
            यदि (!अ.पथमान.है("id")) {
                स्थिर जगह: कार्डस्थान=नया कार्डस्थान(चलअंक(मूल,"lane",०),चलअंक(मूल,"column",१),१);
                फल["id"]=कार्डजोड़ो(प्रति,जगह,मूल);
                स्थिति=२०१;
            } अन्यथा {
                स्थिर पहचान: पूर्णांक=वेब.संख्या(अ.पथमान["id"],२१४७४८३६४७);
                स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(अ.पथ,"/");
                चयन (खंड[खंड.आकार-१]) {
                    विकल्प "details": कार्डसामग्री(सक्रियलो(प्रति,पहचान).कार्ड,मूल);
                    विकल्प "archive": कार्डसंग्रहितकरो(प्रति,पहचान);
                    विकल्प "restore": कार्डवापसलाओ(प्रति,पहचान);
                    शेष:
                        स्थिर जगह: कार्डस्थान=नया कार्डस्थान(चलअंक(मूल,"lane",०),चलअंक(मूल,"column",१),चलअंक(मूल,"position",१));
                        कार्डचलाओ(प्रति,पहचान,जगह);
                }
            }
            फल["revision"]=प्रतीक्षा भंडार.सहेजो(पट,प्रति,प्रति.नाम,असत्य,म,अ,घटनाएँ,चिह्न);
        }
        स्थिर उत्तर: वेबउत्तर=वेब.जेसन(स्थिति,फल);
        उत्तर.शीर्षरखो("Cache-Control","no-store");
        लौटाओ उत्तर;
    }
}
