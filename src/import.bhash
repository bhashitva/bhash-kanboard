// SPDX-License-Identifier: Apache-2.0
आयात मानक.जेसन;
आयात मानक.फ़ाइल;
आयात मानक.पाठ्य;
आयात मानक.वेब;
आयात मानक.संग्रह;
आयात मानक.पूर्णांकक्रम;

फलन आयातवस्तु(मूल: सर्ववस्तु) -> मानचित्र<पाठ,सर्ववस्तु> {
    यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) { फेंको नया अपवाद("getBoard में JSON वस्तु चाहिए।"); }
    लौटाओ परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
}

फलन आयातसूची(मूल: सर्ववस्तु, सीमा: पूर्णांक) -> सूची<सर्ववस्तु> {
    यदि (!प्रकारहै<सूची<सर्ववस्तु>>(मूल)) { फेंको नया अपवाद("getBoard में JSON सूची चाहिए।"); }
    स्थिर फल: सूची<सर्ववस्तु> = परिवर्तित<सूची<सर्ववस्तु>>(मूल);
    यदि (फल.आकार>सीमा) { फेंको नया अपवाद("getBoard सूची सीमा से बड़ी है।"); }
    लौटाओ फल;
}

फलन आयातअंक(मूल: सर्ववस्तु, न्यूनतम: पूर्णांक) -> पूर्णांक {
    मान अंक: पूर्णांक=-१;
    यदि (प्रकारहै<पूर्णांक>(मूल)) { अंक=परिवर्तित<पूर्णांक>(मूल); }
    यदि (प्रकारहै<पाठ>(मूल)) { अंक=वेब.संख्या(परिवर्तित<पाठ>(मूल),२१४७४८३६४७); }
    यदि (अंक<न्यूनतम || अंक>२१४७४८३६४७) { फेंको नया अपवाद("getBoard पहचान या क्रम अमान्य है।"); }
    लौटाओ अंक;
}

फलन आयातपाठ(मूल: सर्ववस्तु, सीमा: पूर्णांक) -> पाठ {
    यदि (!प्रकारहै<पाठ>(मूल)) { फेंको नया अपवाद("getBoard में पाठ चाहिए।"); }
    स्थिर फल: पाठ=परिवर्तित<पाठ>(मूल);
    यदि (पाठ्य.यूटीएफ८(फल).आकार>सीमा) { फेंको नया अपवाद("getBoard पाठ सीमा से बड़ा है।"); }
    लौटाओ फल;
}

// Sort by upstream position, with source order as the fallback for older exports.
फलन आयातक्रम(मूल: सूची<सर्ववस्तु>) -> सूची<सर्ववस्तु> {
    स्थिर क्रम: सूची<पूर्णांक> = नया सूची<पूर्णांक>();
    स्थिर पंक्तियाँ: मानचित्र<पूर्णांक,सर्ववस्तु> = नया मानचित्र<पूर्णांक,सर्ववस्तु>();
    प्रत्येक (मूल में मानक: सर्ववस्तु) {
        स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(मानक);
        मान स्थान: पूर्णांक=क्रम.आकार+१;
        यदि (पंक्ति.है("position")) { स्थान=आयातअंक(पंक्ति["position"],०); }
        यदि (पंक्तियाँ.है(स्थान)) { फेंको नया अपवाद("getBoard में दो पंक्तियों का क्रम समान है।"); }
        क्रम.जोड़ो(स्थान);
        पंक्तियाँ[स्थान]=पंक्ति;
    }
    स्थिर क्रमित: सूची<पूर्णांक> = संग्रह<पूर्णांक>.क्रमित(क्रम,नया पूर्णांकक्रम());
    स्थिर फल: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
    प्रत्येक (क्रमित में स्थान: पूर्णांक) { फल.जोड़ो(पंक्तियाँ[स्थान]); }
    लौटाओ फल;
}

वर्ग पटआयात {
    निजी मान कार्ड: मानचित्र<पूर्णांक,तार्किक>;
    निजी मान परियोजना: पूर्णांक=०;

    निर्माता() { कार्ड=नया मानचित्र<पूर्णांक,तार्किक>(); }

    निजी फलन कार्डलो(मूल: मानचित्र<पाठ,सर्ववस्तु>, पंक्ति: पूर्णांक, स्तंभ: पूर्णांक) -> मानचित्र<पाठ,सर्ववस्तु> {
        स्थिर पहचान: पूर्णांक=आयातअंक(मूल["id"],१);
        यदि (कार्ड.आकार>=२५० || कार्ड.है(पहचान)) { फेंको नया अपवाद("कार्ड दोहराया गया है या कार्ड सीमा पार हो गई है।"); }
        यदि ((मूल.है("column_id") && आयातअंक(मूल["column_id"],१)!=स्तंभ)
            || (मूल.है("swimlane_id") && आयातअंक(मूल["swimlane_id"],०)!=पंक्ति)) {
            फेंको नया अपवाद("कार्ड का स्तंभ या पंक्ति मेल नहीं खाती।");
        }
        यदि (मूल.है("project_id")) { यह.परियोजनाजाँचो(मूल["project_id"]); }
        कार्ड[पहचान]=सत्य;
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        फल["id"]=पहचान;
        फल["title"]=आयातपाठ(मूल["title"],४००);
        फल["description"]="";
        यदि (मूल.है("description") && मूल["description"]!=रिक्त) {
            फल["description"]=आयातपाठ(मूल["description"],४०९६);
        }
        लौटाओ फल;
    }

    निजी फलन परियोजनाजाँचो(मूल: सर्ववस्तु) -> शून्य {
        स्थिर पहचान: पूर्णांक=आयातअंक(मूल,१);
        यदि (परियोजना!=० && परियोजना!=पहचान) { फेंको नया अपवाद("केवल एक परियोजना आयात करें।"); }
        परियोजना=पहचान;
    }

    निजी फलन पंक्तिलो(मूल: मानचित्र<पाठ,सर्ववस्तु>) -> मानचित्र<पाठ,सर्ववस्तु> {
        स्थिर पहचान: पूर्णांक=आयातअंक(मूल["id"],०);
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        स्थिर स्तंभ: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        स्थिर देखे: मानचित्र<पूर्णांक,तार्किक> = नया मानचित्र<पूर्णांक,तार्किक>();
        फल["id"]=पहचान; फल["name"]=आयातपाठ(मूल["name"],४००); फल["columns"]=स्तंभ;
        प्रत्येक (आयातक्रम(आयातसूची(मूल["columns"],१६)) में मानक: सर्ववस्तु) {
            स्थिर क: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(मानक);
            स्थिर क्रमांक: पूर्णांक=आयातअंक(क["id"],१);
            यदि (देखे.है(क्रमांक)) { फेंको नया अपवाद("पंक्ति में एक ही स्तंभ दो बार आया है।"); }
            देखे[क्रमांक]=सत्य;
            यदि (क.है("project_id")) { यह.परियोजनाजाँचो(क["project_id"]); }
            स्थिर उ: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
            स्थिर कार्य: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
            उ["id"]=क्रमांक; उ["title"]=आयातपाठ(क["title"],४००); उ["tasks"]=कार्य;
            प्रत्येक (आयातक्रम(आयातसूची(क["tasks"],२५०)) में त: सर्ववस्तु) {
                कार्य.जोड़ो(यह.कार्डलो(आयातवस्तु(त),पहचान,क्रमांक));
            }
            स्तंभ.जोड़ो(उ);
        }
        लौटाओ फल;
    }

    सार्वजनिक फलन पढ़ो(पथ: पाठ) -> पाठ {
        स्थिर सामग्री: पाठ=फ़ाइल.पाठपढ़ो(पथ);
        यदि (पाठ्य.यूटीएफ८(सामग्री).आकार>२०९७१५२) { फेंको नया अपवाद("getBoard फ़ाइल २ MiB से बड़ी है।"); }
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(जेसन.पढ़ो(सामग्री));
        यदि (मूल.है("error") || !मूल.है("result")) { फेंको नया अपवाद("सफल getBoard उत्तर चाहिए।"); }
        स्थिर पंक्तियाँ: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        स्थिर देखी: मानचित्र<पूर्णांक,तार्किक> = नया मानचित्र<पूर्णांक,तार्किक>();
        प्रत्येक (आयातक्रम(आयातसूची(मूल["result"],१६)) में मानक: सर्ववस्तु) {
            स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = यह.पंक्तिलो(आयातवस्तु(मानक));
            स्थिर पहचान: पूर्णांक=परिवर्तित<पूर्णांक>(पंक्ति["id"]);
            यदि (देखी.है(पहचान)) { फेंको नया अपवाद("एक ही पंक्ति दो बार आई है।"); }
            देखी[पहचान]=सत्य; पंक्तियाँ.जोड़ो(पंक्ति);
        }
        यदि (पंक्तियाँ.आकार==०) { फेंको नया अपवाद("getBoard में कोई पंक्ति नहीं मिली।"); }
        स्थिर फल: पाठ=जेसन.पाठबनाओ(पंक्तियाँ);
        यदि (पाठ्य.यूटीएफ८(फल).आकार>३९३२१६) { फेंको नया अपवाद("आयातित कार्यपट ३८४ KiB से बड़ा है।"); }
        लौटाओ फल;
    }
}
