आयात मानक.वेबत्रुटि;
आयात मानक.पाठ्य;

अभिलेख मिलाकार्ड(स्थान: कार्डस्थान, कार्ड: मानचित्र<पाठ,सर्ववस्तु>, सूचीमान: सूची<सर्ववस्तु>);

फलन सक्रियलो(प्रति: पटप्रति, पहचान: पूर्णांक) -> मिलाकार्ड {
    प्रत्येक (प्रति.पंक्तियाँ में प: सर्ववस्तु) {
        स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(प);
        प्रत्येक (आयातसूची(पंक्ति["columns"],१६) में स: सर्ववस्तु) {
            स्थिर स्तंभ: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(स);
            स्थिर सूचीमान: सूची<सर्ववस्तु> = आयातसूची(स्तंभ["tasks"],२५०);
            मान सूचक: पूर्णांक=०;
            जबतक (सूचक<सूचीमान.आकार) {
                स्थिर कार्ड: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(सूचीमान[सूचक]);
                यदि (आयातअंक(कार्ड["id"],१)==पहचान) {
                    स्थिर जगह: कार्डस्थान=नया कार्डस्थान(आयातअंक(पंक्ति["id"],०),आयातअंक(स्तंभ["id"],१),सूचक+१);
                    लौटाओ नया मिलाकार्ड(जगह,कार्ड,सूचीमान);
                }
                सूचक=सूचक+१;
            }
        }
    }
    फेंको नया वेबत्रुटि(४०४,"सक्रिय कार्ड नहीं मिला।");
}

फलन कार्डसामग्री(कार्ड: मानचित्र<पाठ,सर्ववस्तु>, मूल: मानचित्र<पाठ,सर्ववस्तु>) -> शून्य {
    स्थिर शीर्षक: पाठ=पाठ्य.छाँटो(पाठलो(मूल,"title",४००));
    यदि (शीर्षक=="" || !मूल.है("description") || !प्रकारहै<पाठ>(मूल["description"])) {
        फेंको नया वेबत्रुटि(४२२,"शीर्षक और विवरण चाहिए।");
    }
    स्थिर विवरण: पाठ=परिवर्तित<पाठ>(मूल["description"]);
    यदि (पाठ्य.यूटीएफ८(विवरण).आकार>४०९६) { फेंको नया वेबत्रुटि(४२२,"विवरण पाठ सीमा से बाहर है।"); }
    कार्ड["title"]=शीर्षक; कार्ड["description"]=विवरण;
}

फलन अगलीपहचान(प्रति: पटप्रति) -> पूर्णांक {
    स्थिर पहचानें: मानचित्र<पूर्णांक,तार्किक> = नया मानचित्र<पूर्णांक,तार्किक>();
    प्रत्येक (प्रति.पंक्तियाँ में प: सर्ववस्तु) {
        प्रत्येक (आयातसूची(आयातवस्तु(प)["columns"],१६) में स: सर्ववस्तु) {
            प्रत्येक (आयातसूची(आयातवस्तु(स)["tasks"],२५०) में त: सर्ववस्तु) {
                पहचानें[आयातअंक(आयातवस्तु(त)["id"],१)]=सत्य;
            }
        }
    }
    प्रत्येक (प्रति.अभिलेखित में त: सर्ववस्तु) {
        पहचानें[आयातअंक(आयातवस्तु(आयातवस्तु(त)["card"])["id"],१)]=सत्य;
    }
    यदि (पहचानें.आकार>=२५०) { फेंको नया वेबत्रुटि(४२२,"कार्यपट की कार्ड सीमा पूरी हो गई है।"); }
    मान अगली: पूर्णांक=१;
    जबतक (पहचानें.है(अगली)) { अगली=अगली+१; }
    लौटाओ अगली;
}

फलन कार्डजोड़ो(प्रति: पटप्रति, जगह: कार्डस्थान, मूल: मानचित्र<पाठ,सर्ववस्तु>) -> पूर्णांक {
    स्थिर सूचीमान: सूची<सर्ववस्तु> = कार्डसूची(प्रति.पंक्तियाँ,जगह);
    स्थिर पहचान: पूर्णांक=अगलीपहचान(प्रति);
    स्थिर कार्ड: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
    कार्ड["id"]=पहचान;
    कार्डसामग्री(कार्ड,मूल);
    सूचीमान.जोड़ो(कार्ड);
    लौटाओ पहचान;
}

फलन कार्डचलाओ(प्रति: पटप्रति, पहचान: पूर्णांक, जगह: कार्डस्थान) -> शून्य {
    स्थिर गंतव्य: सूची<सर्ववस्तु> = कार्डसूची(प्रति.पंक्तियाँ,जगह);
    स्थिर मिला: मिलाकार्ड=सक्रियलो(प्रति,पहचान);
    मिला.सूचीमान.हटाओ(मिला.स्थान.क्रम-१);
    यदि (जगह.क्रम>गंतव्य.आकार+१) { फेंको नया वेबत्रुटि(४२२,"कार्ड का क्रम अमान्य है।"); }
    गंतव्य.डालो(जगह.क्रम-१,मिला.कार्ड);
}

फलन कार्डसंग्रहितकरो(प्रति: पटप्रति, पहचान: पूर्णांक) -> शून्य {
    स्थिर मिला: मिलाकार्ड=सक्रियलो(प्रति,पहचान);
    स्थिर प्रविष्टि: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
    प्रविष्टि["card"]=मिला.कार्ड;
    प्रविष्टि["lane"]=मिला.स्थान.पंक्ति;
    प्रविष्टि["column"]=मिला.स्थान.स्तंभ;
    प्रविष्टि["position"]=मिला.स्थान.क्रम;
    मिला.सूचीमान.हटाओ(मिला.स्थान.क्रम-१);
    प्रति.अभिलेखित.जोड़ो(प्रविष्टि);
}

फलन कार्डवापसलाओ(प्रति: पटप्रति, पहचान: पूर्णांक) -> शून्य {
    मान सूचक: पूर्णांक=०;
    जबतक (सूचक<प्रति.अभिलेखित.आकार) {
        स्थिर प्रविष्टि: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(प्रति.अभिलेखित[सूचक]);
        स्थिर कार्ड: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(प्रविष्टि["card"]);
        यदि (आयातअंक(कार्ड["id"],१)==पहचान) {
            स्थिर जगह: कार्डस्थान=नया कार्डस्थान(आयातअंक(प्रविष्टि["lane"],०),
                आयातअंक(प्रविष्टि["column"],१),आयातअंक(प्रविष्टि["position"],१));
            स्थिर गंतव्य: सूची<सर्ववस्तु> = कार्डसूची(प्रति.पंक्तियाँ,जगह);
            मान क्रम: पूर्णांक=जगह.क्रम-१;
            यदि (क्रम>गंतव्य.आकार) { क्रम=गंतव्य.आकार; }
            गंतव्य.डालो(क्रम,कार्ड);
            प्रति.अभिलेखित.हटाओ(सूचक);
            लौटाओ;
        }
        सूचक=सूचक+१;
    }
    फेंको नया वेबत्रुटि(४०४,"संग्रहीत कार्ड नहीं मिला।");
}
