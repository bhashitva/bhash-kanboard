आयात मानक.असमएचटीटीपीसर्वर;
आयात मानक.असमवेबअनुप्रयोग;
आयात मानक.असमसुरक्षितवेब;
आयात मानक.वेबचालक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेब;
आयात मानक.वेबसॉकेटमार्ग;
आयात मानक.सत्रप्रबंधक;
आयात मानक.प्रवेशरक्षक;
आयात मानक.वास्तविकसत्रघड़ी;
आयात मानक.विन्यास;
आयात मानक.फ़ाइल;
आयात मानक.पाठ्य;

वर्ग स्थिरपृष्ठ पालन वेबचालक {
    निजी मान सामग्री: पाठ;
    निजी मान प्रकार: पाठ;
    निजी मान सॉकेटमूल: पाठ;
    निर्माता(सामग्री: पाठ, प्रकार: पाठ, सॉकेटमूल: पाठ) {
        यह.सामग्री=सामग्री; यह.प्रकार=प्रकार; यह.सॉकेटमूल=सॉकेटमूल;
    }
    सार्वजनिक फलन संभालो(अनुरोध: वेबअनुरोध) -> वेबउत्तर {
        स्थिर उत्तर: वेबउत्तर=वेब.पाठउत्तर(२००,सामग्री);
        उत्तर.शीर्षरखो("Content-Type",प्रकार);
        उत्तर.शीर्षरखो("Content-Security-Policy","default-src 'self'; connect-src 'self' "+सॉकेटमूल+"; frame-ancestors 'none'; base-uri 'none'; form-action 'self'");
        लौटाओ उत्तर;
    }
}

फलन खातालो(नाम: पाठ) -> पाठ {
    स्थिर मानक: पाठ=विन्यास.परिवेश(नाम,"");
    यदि (पाठ्य.लंबाई(मानक)<१२ || पाठ्य.यूटीएफ८(मानक).आकार>१०२४) {
        फेंको नया अपवाद(नाम+" में १२ से १०२४ बाइट की सीमा वाला कूटशब्द दें।");
    }
    लौटाओ मानक;
}

असमकालिक फलन मुख्य() -> शून्य {
    स्थिर त: विन्यास=विन्यास.तर्क();
    स्थिर पथ: पाठ=त.पढ़ो("db","kanboard.db");
    स्थिर भंडार: पटभंडार=नया पटभंडार(पथ);
    भंडार.आरंभकरो(त.पढ़ो("import",""));
    स्थिर सदस्य: सदस्यभंडार=नया सदस्यभंडार(पथ);
    सदस्य.नमूना();
    स्थिर घटनाएँ: पटघटनाएँ=नया पटघटनाएँ();
    स्थिर साधन: पाठ=त.पढ़ो("assets",".");
    संसाधन (सर्वर: असमएचटीटीपीसर्वर=नया असमएचटीटीपीसर्वर("127.0.0.1",वेब.संख्या(त.पढ़ो("port","8080"),६५५३५))) {
        मान म: सत्रप्रबंधक=रिक्त;
        मान सॉकेटमूल: पाठ="";
        यदि (त.पढ़ो("local","false")=="true") {
            स्थिर अधिकार: पाठ="127.0.0.1:"+वेब.अंक(सर्वर.पोर्ट());
            म=सत्रप्रबंधक.स्थानीय("http://"+अधिकार); सॉकेटमूल="ws://"+अधिकार;
        } अन्यथा {
            स्थिर मूल: पाठ=त.पढ़ो("origin","https://localhost");
            म=नया सत्रप्रबंधक(मूल);
            सॉकेटमूल="wss://"+पाठ्य.अंश(मूल,८,पाठ्य.लंबाई(मूल));
        }
        संसाधन (सत्रमान: सत्रप्रबंधक=म) {
            संसाधन (रक्षक: प्रवेशरक्षक=नया प्रवेशरक्षक()) {
                संसाधन (पंजीरक्षक: प्रवेशरक्षक=नया प्रवेशरक्षक(२०,६००००,१,नया वास्तविकसत्रघड़ी())) {
                    स्थिर मार्ग: असमवेबअनुप्रयोग=नया असमवेबअनुप्रयोग();
                    स्थिर प्रवेश: पटप्रवेश=नया पटप्रवेश(म,सदस्य,रक्षक,पंजीरक्षक);
                    स्थिर पट: पटचालक=नया पटचालक(म,भंडार,घटनाएँ,सदस्य);
                    मार्ग.समजोड़ो("GET","/",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(साधन+"/index.html"),"text/html; charset=utf-8",सॉकेटमूल));
                    मार्ग.समजोड़ो("GET","/app.js",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(साधन+"/app.js"),"text/javascript; charset=utf-8",सॉकेटमूल));
                    मार्ग.समजोड़ो("GET","/style.css",नया स्थिरपृष्ठ(फ़ाइल.पाठपढ़ो(साधन+"/style.css"),"text/css; charset=utf-8",सॉकेटमूल));
                    मार्ग.जोड़ो("GET","/session",प्रवेश);
                    मार्ग.जोड़ो("POST","/login",प्रवेश);
                    मार्ग.जोड़ो("POST","/logout",प्रवेश);
                    मार्ग.जोड़ो("POST","/register",प्रवेश);
                    स्थिर आमंत्रण: आमंत्रणचालक=नया आमंत्रणचालक(म,सदस्य,रक्षक);
                    मार्ग.जोड़ो("POST","/api/boards/:board/invitations",आमंत्रण);
                    मार्ग.जोड़ो("POST","/api/invitations/accept",आमंत्रण);
                    मार्ग.जोड़ो("GET","/api/boards/:board",पट);
                    मार्ग.जोड़ो("POST","/api/boards/:board/tasks",पट);
                    मार्ग.जोड़ो("PATCH","/api/boards/:board/tasks/:id",पट);
                    मार्ग.जोड़ो("PATCH","/api/boards/:board/tasks/:id/details",पट);
                    मार्ग.जोड़ो("POST","/api/boards/:board/tasks/:id/archive",पट);
                    मार्ग.जोड़ो("POST","/api/boards/:board/tasks/:id/restore",पट);
                    स्थिर उन्नयन: वेबसॉकेटमार्ग=नया वेबसॉकेटमार्ग();
                    उन्नयन.जोड़ो("/live/:board",म,"member","bhash.board.v1",नया पटसॉकेट(घटनाएँ,सदस्य));
                    लिखो("READY "+वेब.अंक(सर्वर.पोर्ट()));
                    प्रतीक्षा सर्वर.उन्नयनचलाओ(नया असमसुरक्षितवेब(म,मार्ग),उन्नयन);
                }
            }
        }
    }
}
