आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटाकथन;
आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.डेटाकथन;
आयात मानक.माइग्रेशन;
आयात मानक.माइग्रेशनयोजना;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.सत्रप्रबंधक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबत्रुटि;
आयात मानक.जेसन;
आयात मानक.पाठ्य;

अभिलेख पटप्रति(संस्करण: पूर्णांक, पंक्तियाँ: सूची<सर्ववस्तु>, अभिलेखित: सूची<सर्ववस्तु>);
अभिलेख कार्डस्थान(पंक्ति: पूर्णांक, स्तंभ: पूर्णांक, क्रम: पूर्णांक);

फलन कार्डसूची(पंक्तियाँ: सूची<सर्ववस्तु>, जगह: कार्डस्थान) -> सूची<सर्ववस्तु> {
    प्रत्येक (पंक्तियाँ में प: सर्ववस्तु) {
        स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(प);
        यदि (आयातअंक(पंक्ति["id"],०)==जगह.पंक्ति) {
            प्रत्येक (आयातसूची(पंक्ति["columns"],१६) में स: सर्ववस्तु) {
                स्थिर स्तंभ: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(स);
                यदि (आयातअंक(स्तंभ["id"],१)==जगह.स्तंभ) { लौटाओ आयातसूची(स्तंभ["tasks"],२५०); }
            }
        }
    }
    फेंको नया वेबत्रुटि(४२२,"गंतव्य स्तंभ नहीं मिला।");
}

वर्ग पटभंडार {
    निजी मान पथ: पाठ;
    निर्माता(पथ: पाठ) { यह.पथ=पथ; }

    सार्वजनिक फलन आरंभकरो(आयातपथ: पाठ) -> शून्य {
        संसाधन (डाटा: डेटासंबंध=डेटा.एसक्यूलाइट(पथ)) {
            स्थिर योजना: माइग्रेशनयोजना=नया माइग्रेशनयोजना(नया सूची<माइग्रेशन>{
                नया माइग्रेशन(१,"कार्यपट",नया सूची<पाठ>{
                    "CREATE TABLE boards (id TEXT PRIMARY KEY NOT NULL, revision INTEGER NOT NULL, lanes TEXT NOT NULL, imported BOOLEAN NOT NULL)",
                    "INSERT INTO boards VALUES ('team',0,'[]',FALSE),('studio',0,'[]',FALSE)"
                }),
                नया माइग्रेशन(२,"संग्रहीत कार्ड",नया सूची<पाठ>{
                    "ALTER TABLE boards ADD COLUMN archived TEXT NOT NULL DEFAULT '[]'"
                })
            });
            योजना.लागूकरो(डाटा);
            यदि (आयातपथ!="") {
                स्थिर पंक्तियाँ: पाठ=नया पटआयात().पढ़ो(आयातपथ);
                संसाधन (क: डेटाकथन=डाटा.तैयार("UPDATE boards SET lanes=?, imported=TRUE, revision=1 WHERE id='team' AND imported=FALSE")) {
                    क.पाठरखो(१,पंक्तियाँ);
                    यदि (क.चलाओ()!=१) { फेंको नया अपवाद("इस डेटाबेस में परियोजना पहले से आयातित है।"); }
                }
            }
        }
    }

    सार्वजनिक असमकालिक फलन प्रतिलो(पट: पाठ, चिह्न: निरस्तीकरणचिह्न) -> पटप्रति {
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT revision, lanes, archived FROM boards WHERE id=?",चिह्न)) {
                क.पाठरखो(१,पट);
                यदि (!(प्रतीक्षा क.अगला(चिह्न))) { फेंको नया वेबत्रुटि(४०४,"कार्यपट नहीं मिला।"); }
                लौटाओ नया पटप्रति(क.पूर्णांकलो(०),आयातसूची(जेसन.पढ़ो(क.पाठलो(१)),१६),
                    आयातसूची(जेसन.पढ़ो(क.पाठलो(२)),२५०));
            }
        }
    }

    सार्वजनिक असमकालिक फलन सहेजो(पट: पाठ, प्रति: पटप्रति,
        म: सत्रप्रबंधक, अ: वेबअनुरोध, घटनाएँ: पटघटनाएँ, चिह्न: निरस्तीकरणचिह्न) -> पूर्णांक {
        स्थिर संस्करण: पूर्णांक=प्रति.संस्करण;
        स्थिर पंक्तियाँ: पाठ=जेसन.पाठबनाओ(प्रति.पंक्तियाँ);
        स्थिर संग्रह: पाठ=जेसन.पाठबनाओ(प्रति.अभिलेखित);
        यदि (पाठ्य.यूटीएफ८(पंक्तियाँ).आकार+पाठ्य.यूटीएफ८(संग्रह).आकार>३९३२१६) {
            फेंको नया वेबत्रुटि(४२२,"कार्यपट की पाठ सीमा पार हो गई है।");
        }
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("UPDATE boards SET lanes=?, archived=?, revision=revision+1 WHERE id=? AND revision=?",चिह्न)) {
                क.पाठरखो(१,पंक्तियाँ); क.पाठरखो(२,संग्रह); क.पाठरखो(३,पट); क.पूर्णांकरखो(४,संस्करण);
                यदि (पटमान(म.अधिकृत(अ,"member").उपयोगकर्ता())!=पट) { फेंको नया वेबत्रुटि(४०३,"यह कार्यपट उपलब्ध नहीं है।"); }
                // SQLite autocommits this compare-and-swap before returning the row count.
                यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"कार्यपट का संस्करण बदल गया है।"); }
                घटनाएँ.सूचितकरो(पट,संस्करण+१);
            }
        }
        लौटाओ संस्करण+१;
    }
}
