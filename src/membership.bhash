आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटाकथन;
आयात मानक.डेटा;
आयात मानक.डेटासंबंध;
आयात मानक.डेटाकथन;
आयात मानक.डेटालेनदेन;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.कूटशब्द;
आयात मानक.पाठ्य;
आयात मानक.समय;
आयात मानक.सुरक्षा;
आयात मानक.वेबत्रुटि;
आयात मानक.सत्रप्रबंधक;
आयात मानक.वेबअनुरोध;

फलन खातानाम(मूल: मानचित्र<पाठ,सर्ववस्तु>) -> पाठ {
    स्थिर नाम: पाठ=पाठलो(मूल,"username",३२);
    स्थिर आकार: पूर्णांक=पाठ्य.लंबाई(नाम);
    यदि (आकार<३) { फेंको नया वेबत्रुटि(४२२,"उपयोगकर्ता नाम ३ से ३२ अक्षर का होना चाहिए।"); }
    मान क: पूर्णांक=०;
    जबतक (क<आकार) {
        यदि (!पाठ्य.है("abcdefghijklmnopqrstuvwxyz0123456789_-",पाठ्य.अंश(नाम,क,क+१))) {
            फेंको नया वेबत्रुटि(४२२,"उपयोगकर्ता नाम में छोटे अंग्रेज़ी अक्षर, अंक, _ या - दें।");
        }
        क=क+१;
    }
    लौटाओ नाम;
}

फलन संपादनमान्य(भूमिका: पाठ) -> तार्किक {
    लौटाओ भूमिका=="owner" || भूमिका=="editor";
}

वर्ग सदस्यभंडार {
    निजी मान पथ: पाठ;
    निर्माता(पथ: पाठ) { यह.पथ=पथ; }

    निजी फलन नमूनाखाता(डाटा: डेटासंबंध, नाम: पाठ, पास: पाठ, पट: पाठ, भूमिका: पाठ) -> शून्य {
        संसाधन (क: डेटाकथन=डाटा.तैयार("INSERT INTO accounts VALUES (?,?)")) {
            क.पाठरखो(१,नाम); क.पाठरखो(२,कूटशब्द.हैशबनाओ(पास)); क.चलाओ();
        }
        संसाधन (क: डेटाकथन=डाटा.तैयार("INSERT INTO board_access(board,username,role) VALUES (?,?,?)")) {
            क.पाठरखो(१,पट); क.पाठरखो(२,नाम); क.पाठरखो(३,भूमिका); क.चलाओ();
        }
    }

    सार्वजनिक फलन नमूना() -> शून्य {
        संसाधन (डाटा: डेटासंबंध=डेटा.एसक्यूलाइट(पथ)) {
            संसाधन (क: डेटाकथन=डाटा.तैयार("SELECT 1 FROM accounts LIMIT 1")) {
                यदि (क.अगला()) { लौटाओ; }
            }
            स्थिर अ: पाठ=खातालो("BHASH_BOARD_ALICE_PASSWORD");
            स्थिर ब: पाठ=खातालो("BHASH_BOARD_BOB_PASSWORD");
            स्थिर च: पाठ=खातालो("BHASH_BOARD_CHARLIE_PASSWORD");
            यदि (अ==ब || अ==च || ब==च) { फेंको नया अपवाद("हर खाते का अलग कूटशब्द दें।"); }
            संसाधन (लेन: डेटालेनदेन=डाटा.लेनदेन()) {
                यह.नमूनाखाता(डाटा,"alice",अ,"team","owner");
                यह.नमूनाखाता(डाटा,"bob",ब,"team","editor");
                यह.नमूनाखाता(डाटा,"charlie",च,"studio","owner");
                लेन.सहेजो();
            }
        }
    }

    सार्वजनिक असमकालिक फलन हैशलो(नाम: पाठ, चिह्न: निरस्तीकरणचिह्न) -> पाठ {
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT password_hash FROM accounts WHERE username=?",चिह्न)) {
                क.पाठरखो(१,नाम);
                यदि (प्रतीक्षा क.अगला(चिह्न)) { लौटाओ क.पाठलो(०); }
            }
        }
        लौटाओ "";
    }

    सार्वजनिक असमकालिक फलन पंजीकरण(नाम: पाठ, पास: पाठ, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        स्थिर हैश: पाठ=कूटशब्द.हैशबनाओ(पास);
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("INSERT INTO accounts SELECT ?,? WHERE (SELECT count(*) FROM accounts)<1000 ON CONFLICT(username) DO NOTHING",चिह्न)) {
                क.पाठरखो(१,नाम); क.पाठरखो(२,हैश);
                यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"यह नाम उपलब्ध नहीं है या खाता सीमा पूरी है।"); }
            }
        }
    }

    सार्वजनिक असमकालिक फलन भूमिका(पट: पाठ, नाम: पाठ, चिह्न: निरस्तीकरणचिह्न) -> पाठ {
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT role FROM board_access WHERE board=? AND username=? AND invite_hash IS NULL",चिह्न)) {
                क.पाठरखो(१,पट); क.पाठरखो(२,नाम);
                यदि (प्रतीक्षा क.अगला(चिह्न)) { लौटाओ क.पाठलो(०); }
            }
        }
        लौटाओ "";
    }

    सार्वजनिक असमकालिक फलन पटसूची(नाम: पाठ, चिह्न: निरस्तीकरणचिह्न) -> सूची<सर्ववस्तु> {
        स्थिर फल: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT board,role FROM board_access WHERE username=? AND invite_hash IS NULL ORDER BY board",चिह्न)) {
                क.पाठरखो(१,नाम);
                जबतक (प्रतीक्षा क.अगला(चिह्न)) {
                    स्थिर प्रविष्टि: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
                    प्रविष्टि["id"]=क.पाठलो(०); प्रविष्टि["role"]=क.पाठलो(१);
                    फल.जोड़ो(प्रविष्टि);
                }
            }
        }
        लौटाओ फल;
    }

    सार्वजनिक असमकालिक फलन निमंत्रणबनाओ(पट: पाठ, मालिक: पाठ, नाम: पाठ, भूमिका: पाठ, म: सत्रप्रबंधक, अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> पाठ {
        यदि ((प्रतीक्षा यह.भूमिका(पट,मालिक,चिह्न))!="owner") { फेंको नया वेबत्रुटि(४०३,"केवल मालिक निमंत्रण दे सकता है।"); }
        स्थिर टोकन: पाठ=सुरक्षा.टोकन();
        स्थिर हैश: पाठ=कूटशब्द.हैशबनाओ(टोकन);
        स्थिर समाप्ति: पूर्णांक=समय.अभी()+८६४०००००;
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("INSERT INTO board_access SELECT ?,?,?,?,? WHERE EXISTS (SELECT 1 FROM accounts WHERE username=?) AND EXISTS (SELECT 1 FROM board_access WHERE board=? AND username=? AND role='owner' AND invite_hash IS NULL) ON CONFLICT(board,username) DO UPDATE SET role=excluded.role,invite_hash=excluded.invite_hash,expires=excluded.expires WHERE board_access.invite_hash IS NOT NULL",चिह्न)) {
                क.पाठरखो(१,पट); क.पाठरखो(२,नाम); क.पाठरखो(३,भूमिका); क.पाठरखो(४,हैश); क.पूर्णांकरखो(५,समाप्ति);
                क.पाठरखो(६,नाम); क.पाठरखो(७,पट); क.पाठरखो(८,म.अधिकृत(अ,"member").उपयोगकर्ता());
                यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"पंजीकृत गैर-सदस्य को निमंत्रण दें।"); }
            }
        }
        लौटाओ टोकन;
    }

    सार्वजनिक असमकालिक फलन स्वीकारो(पट: पाठ, नाम: पाठ, टोकन: पाठ, म: सत्रप्रबंधक, अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            मान हैश: पाठ="";
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT invite_hash FROM board_access WHERE board=? AND username=? AND invite_hash IS NOT NULL AND expires>?",चिह्न)) {
                क.पाठरखो(१,पट); क.पाठरखो(२,नाम); क.पूर्णांकरखो(३,समय.अभी());
                यदि (प्रतीक्षा क.अगला(चिह्न)) { हैश=क.पाठलो(०); }
            }
            यदि (हैश=="" || !कूटशब्द.जाँचो(टोकन,हैश)) { फेंको नया वेबत्रुटि(४०३,"निमंत्रण उपलब्ध नहीं है।"); }
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("UPDATE board_access SET invite_hash=NULL,expires=NULL WHERE board=? AND username=? AND invite_hash=? AND expires>?",चिह्न)) {
                क.पाठरखो(१,पट); क.पाठरखो(२,म.अधिकृत(अ,"member").उपयोगकर्ता()); क.पाठरखो(३,हैश); क.पूर्णांकरखो(४,समय.अभी());
                यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०३,"निमंत्रण उपलब्ध नहीं है।"); }
            }
        }
    }
}
