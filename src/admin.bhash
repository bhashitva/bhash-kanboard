आयात मानक.असमडेटा;
आयात मानक.असमडेटासंबंध;
आयात मानक.असमडेटाकथन;
आयात मानक.असमडेटालेनदेन;
आयात मानक.असमवेबचालक;
आयात मानक.वेब;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेबत्रुटि;
आयात मानक.सत्रप्रबंधक;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.सुरक्षा;
आयात मानक.पाठ्य;
आयात मानक.जेसन;

वर्ग पटप्रबंधन पालन असमवेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान सदस्य: सदस्यभंडार;
    निजी मान भंडार: पटभंडार;
    निजी मान घटनाएँ: पटघटनाएँ;
    निजी मान पथ: पाठ;

    निर्माता(म: सत्रप्रबंधक, सदस्य: सदस्यभंडार, भंडार: पटभंडार, घटनाएँ: पटघटनाएँ, पथ: पाठ) {
        यह.म=म; यह.सदस्य=सदस्य; यह.भंडार=भंडार; यह.घटनाएँ=घटनाएँ; यह.पथ=पथ;
    }

    निजी असमकालिक फलन बनाओ(अ: वेबअनुरोध, नाम: पाठ, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर पट: पाठ=पाठ्य.अंश(सुरक्षा.टोकन(),०,२४);
        स्थिर पंक्तियाँ: पाठ=जेसन.पाठबनाओ(मूलपंक्तियाँ());
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (लेन: असमडेटालेनदेन=प्रतीक्षा डाटा.लेनदेन(चिह्न)) {
                स्थिर मालिक: पाठ=म.अधिकृत(अ,"member").उपयोगकर्ता();
                असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("INSERT INTO boards(id,revision,lanes,imported,name,creator) SELECT ?,1,?,TRUE,?,? WHERE (SELECT count(*) FROM boards WHERE creator=?)<20",चिह्न)) {
                    क.पाठरखो(१,पट); क.पाठरखो(२,पंक्तियाँ); क.पाठरखो(३,नाम); क.पाठरखो(४,मालिक); क.पाठरखो(५,मालिक);
                    यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४२२,"२० कार्यपटों की सीमा पूरी है।"); }
                }
                असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("INSERT INTO board_access(board,username,role) VALUES (?,?,'owner')",चिह्न)) {
                    क.पाठरखो(१,पट); क.पाठरखो(२,मालिक); प्रतीक्षा क.चलाओ(चिह्न);
                }
                म.अधिकृत(अ,"member");
                प्रतीक्षा लेन.सहेजो(चिह्न);
            }
        }
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        फल["id"]=पट;
        लौटाओ वेब.जेसन(२०१,फल);
    }

    निजी असमकालिक फलन सदस्यसूची(पट: पाठ, अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर फल: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार("SELECT username,role,invite_hash IS NOT NULL FROM board_access WHERE board=? AND EXISTS (SELECT 1 FROM board_access WHERE board=? AND username=? AND role='owner' AND invite_hash IS NULL) ORDER BY username",चिह्न)) {
                क.पाठरखो(१,पट); क.पाठरखो(२,पट); क.पाठरखो(३,म.अधिकृत(अ,"member").उपयोगकर्ता());
                जबतक (प्रतीक्षा क.अगला(चिह्न)) {
                    स्थिर व: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
                    व["username"]=क.पाठलो(०); व["role"]=क.पाठलो(१); व["pending"]=क.पूर्णांकलो(२)!=०;
                    फल.जोड़ो(व);
                }
            }
        }
        म.अधिकृत(अ,"member");
        यदि (फल.आकार==०) { फेंको नया वेबत्रुटि(४०३,"केवल मालिक सदस्य देख सकता है।"); }
        लौटाओ वेब.जेसन(२००,फल);
    }

    निजी असमकालिक फलन सदस्यबदलो(पट: पाठ, अ: वेबअनुरोध, मूल: मानचित्र<पाठ,सर्ववस्तु>, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर नाम: पाठ=खातानाम(मूल);
        स्थिर क्रिया: पाठ=पाठलो(मूल,"action",६);
        मान भूमिका: पाठ="";
        मान कथन: पाठ="DELETE FROM board_access";
        यदि (क्रिया=="role") {
            भूमिका=पाठलो(मूल,"role",६);
            यदि (भूमिका!="owner" && भूमिका!="editor" && भूमिका!="viewer") { फेंको नया वेबत्रुटि(४२२,"भूमिका अमान्य है।"); }
            कथन="UPDATE board_access SET role=?1";
        } अन्यथा यदि (क्रिया!="remove") { फेंको नया वेबत्रुटि(४२२,"सदस्य बदलाव अमान्य है।"); }
        // Permit one atomic change only while the caller owns the board and an owner will remain.
        कथन=कथन+" WHERE board=?2 AND username=?3 AND EXISTS (SELECT 1 FROM board_access caller WHERE caller.board=?2 AND caller.username=?4 AND caller.role='owner' AND caller.invite_hash IS NULL) AND (invite_hash IS NOT NULL OR role<>'owner' OR ?1='owner' OR EXISTS (SELECT 1 FROM board_access other WHERE other.board=?2 AND other.username<>?3 AND other.role='owner' AND other.invite_hash IS NULL)) AND (?1='' OR invite_hash IS NULL)";
        असमकालिक संसाधन (डाटा: असमडेटासंबंध=प्रतीक्षा असमडेटा.एसक्यूलाइट(पथ,चिह्न)) {
            असमकालिक संसाधन (क: असमडेटाकथन=प्रतीक्षा डाटा.तैयार(कथन,चिह्न)) {
                क.पाठरखो(१,भूमिका); क.पाठरखो(२,पट); क.पाठरखो(३,नाम); क.पाठरखो(४,म.अधिकृत(अ,"member").उपयोगकर्ता());
                यदि ((प्रतीक्षा क.चलाओ(चिह्न))!=१) { फेंको नया वेबत्रुटि(४०९,"सदस्य बदलाव अस्वीकार है। एक मालिक आवश्यक है।"); }
                घटनाएँ.अधिकारबदला(पट);
            }
        }
        लौटाओ वेब.पाठउत्तर(२०४,"");
    }

    सार्वजनिक असमकालिक फलन संभालो(अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर नाम: पाठ=म.अधिकृत(अ,"member").उपयोगकर्ता();
        यदि (!अ.पथमान.है("board")) { लौटाओ प्रतीक्षा यह.बनाओ(अ,प्रबंधननाम(वस्तुलो(अ)),चिह्न); }
        स्थिर पट: पाठ=अ.पथमान["board"];
        यदि ((प्रतीक्षा सदस्य.भूमिका(पट,नाम,चिह्न))!="owner") { फेंको नया वेबत्रुटि(४०३,"केवल मालिक कार्यपट प्रबंधित कर सकता है।"); }
        स्थिर खंड: सूची<पाठ> = पाठ्य.बाँटो(अ.पथ,"/");
        यदि (खंड[खंड.आकार-१]=="members") {
            यदि (अ.विधि=="GET" || अ.विधि=="HEAD") { लौटाओ प्रतीक्षा यह.सदस्यसूची(पट,अ,चिह्न); }
            लौटाओ प्रतीक्षा यह.सदस्यबदलो(पट,अ,वस्तुलो(अ),चिह्न);
        }
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
        स्थिर प्रति: पटप्रति=प्रतीक्षा भंडार.प्रतिलो(पट,चिह्न);
        यदि (चलअंक(मूल,"revision",०)!=प्रति.संस्करण || प्रति.संस्करण==२१४७४८३६४७) {
            फेंको नया वेबत्रुटि(४०९,"कार्यपट का संस्करण बदल गया है।");
        }
        स्थिर शीर्षक: पाठ=लेआउटबदलो(प्रति,मूल);
        स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        फल["revision"]=प्रतीक्षा भंडार.सहेजो(पट,प्रति,शीर्षक,सत्य,म,अ,घटनाएँ,चिह्न);
        लौटाओ वेब.जेसन(२००,फल);
    }
}
