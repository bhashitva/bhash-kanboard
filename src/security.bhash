आयात मानक.असमवेबचालक;
आयात मानक.वेब;
आयात मानक.वेबचालक;
आयात मानक.वेबअनुरोध;
आयात मानक.वेबउत्तर;
आयात मानक.वेबत्रुटि;
आयात मानक.सत्र;
आयात मानक.सत्रप्रबंधक;
आयात मानक.प्रवेशरक्षक;
आयात मानक.कूटशब्द;
आयात मानक.पाठ्य;
आयात मानक.कार्य;
आयात मानक.कार्यघड़ी;
आयात मानक.निरस्तीकरणचिह्न;
आयात मानक.वेबसॉकेटचालक;
आयात मानक.वेबसॉकेटसंदर्भ;
आयात मानक.वेबसॉकेटसंबंध;

फलन वस्तुलो(अनुरोध: वेबअनुरोध) -> मानचित्र<पाठ,सर्ववस्तु> {
    स्थिर मूल: सर्ववस्तु=अनुरोध.जेसनलो();
    यदि (!प्रकारहै<मानचित्र<पाठ,सर्ववस्तु>>(मूल)) { फेंको नया वेबत्रुटि(४२२,"JSON वस्तु चाहिए।"); }
    लौटाओ परिवर्तित<मानचित्र<पाठ,सर्ववस्तु>>(मूल);
}

फलन पाठलो(मूल: मानचित्र<पाठ,सर्ववस्तु>, नाम: पाठ, सीमा: पूर्णांक) -> पाठ {
    यदि (!मूल.है(नाम) || !प्रकारहै<पाठ>(मूल[नाम])) { फेंको नया वेबत्रुटि(४२२,"पाठ क्षेत्र चाहिए।"); }
    स्थिर मानक: पाठ=परिवर्तित<पाठ>(मूल[नाम]);
    यदि (मानक=="" || पाठ्य.यूटीएफ८(मानक).आकार>सीमा) { फेंको नया वेबत्रुटि(४२२,"पाठ सीमा से बाहर है।"); }
    लौटाओ मानक;
}

वर्ग पटप्रवेश पालन असमवेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान सदस्य: सदस्यभंडार;
    निजी मान रक्षक: प्रवेशरक्षक;
    निजी मान पंजीरक्षक: प्रवेशरक्षक;
    निर्माता(म: सत्रप्रबंधक, सदस्य: सदस्यभंडार, रक्षक: प्रवेशरक्षक, पंजीरक्षक: प्रवेशरक्षक) {
        यह.म=म; यह.सदस्य=सदस्य; यह.रक्षक=रक्षक; यह.पंजीरक्षक=पंजीरक्षक;
    }

    निजी असमकालिक फलन उत्तर(स: सत्र, स्थिति: पूर्णांक, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर व: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
        स्थिर नाम: पाठ=स.उपयोगकर्ता();
        मान पट: सूची<सर्ववस्तु> = नया सूची<सर्ववस्तु>();
        यदि (नाम!="") { पट=प्रतीक्षा सदस्य.पटसूची(नाम,चिह्न); }
        व["user"]=नाम; व["csrf"]=स.सीएसआरएफ(); व["boards"]=पट;
        व["board"]="";
        यदि (पट.आकार>०) { व["board"]=आयातवस्तु(पट[०])["id"]; }
        स्थिर उ: वेबउत्तर=वेब.जेसन(स्थिति,व);
        म.कुकीरखो(उ,स); लौटाओ उ;
    }

    सार्वजनिक असमकालिक फलन संभालो(अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        यदि (अ.पथ=="/session") {
            मान स: सत्र=म.पाओ(अ);
            यदि (स==रिक्त) { स=म.आरंभ("",नया सूची<पाठ>()); }
            लौटाओ प्रतीक्षा यह.उत्तर(स,२००,चिह्न);
        }
        यदि (अ.पथ=="/logout") {
            स्थिर उ: वेबउत्तर=वेब.पाठउत्तर(२०४,""); म.समाप्त(अ,उ); लौटाओ उ;
        }
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
        स्थिर नाम: पाठ=खातानाम(मूल);
        स्थिर पास: पाठ=पाठलो(मूल,"password",१०२४);
        मान स्थिति: पूर्णांक=२००;
        यदि (अ.पथ=="/register") {
            यदि (पाठ्य.लंबाई(पास)<१२) { फेंको नया वेबत्रुटि(४२२,"कम से कम १२ अक्षरों का कूटशब्द दें।"); }
            पंजीरक्षक.प्रयासकरो("registration");
            प्रतीक्षा सदस्य.पंजीकरण(नाम,पास,चिह्न);
            स्थिति=२०१;
        } अन्यथा {
            रक्षक.प्रयासकरो("login:"+नाम);
            स्थिर पाया: पाठ=प्रतीक्षा सदस्य.हैशलो(नाम,चिह्न);
            // Unknown accounts perform the same password verification work.
            मान हैश: पाठ=पाया;
            यदि (पाया=="") {
                हैश="$bhash$pbkdf2-sha256$600000$000102030405060708090a0b0c0d0e0f$3bc37118e625093e9b79ed08930ea7af7389591233fdd92dddf369371e60dbc0";
            }
            यदि (!कूटशब्द.जाँचो(पास,हैश) || पाया=="") { लौटाओ वेब.त्रुटि(४०१); }
        }
        स्थिर पुराना: सत्र=म.पाओ(अ);
        लौटाओ प्रतीक्षा यह.उत्तर(म.बदलो(पुराना,नाम,नया सूची<पाठ>{"member"}),स्थिति,चिह्न);
    }
}

वर्ग आमंत्रणचालक पालन असमवेबचालक {
    निजी मान म: सत्रप्रबंधक;
    निजी मान सदस्य: सदस्यभंडार;
    निजी मान रक्षक: प्रवेशरक्षक;
    निर्माता(म: सत्रप्रबंधक, सदस्य: सदस्यभंडार, रक्षक: प्रवेशरक्षक) {
        यह.म=म; यह.सदस्य=सदस्य; यह.रक्षक=रक्षक;
    }
    सार्वजनिक असमकालिक फलन संभालो(अ: वेबअनुरोध, चिह्न: निरस्तीकरणचिह्न) -> वेबउत्तर {
        स्थिर नाम: पाठ=म.अधिकृत(अ,"member").उपयोगकर्ता();
        स्थिर मूल: मानचित्र<पाठ,सर्ववस्तु> = वस्तुलो(अ);
        यदि (अ.पथमान.है("board")) {
            स्थिर पट: पाठ=अ.पथमान["board"];
            स्थिर भूमिका: पाठ=पाठलो(मूल,"role",६);
            यदि (भूमिका!="editor" && भूमिका!="viewer") { फेंको नया वेबत्रुटि(४२२,"editor या viewer भूमिका चुनें।"); }
            रक्षक.प्रयासकरो("issue:"+नाम);
            स्थिर टोकन: पाठ=प्रतीक्षा सदस्य.निमंत्रणबनाओ(पट,नाम,खातानाम(मूल),भूमिका,म,अ,चिह्न);
            स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
            फल["code"]=पट+"."+टोकन;
            लौटाओ वेब.जेसन(२०१,फल);
        }
        रक्षक.प्रयासकरो("accept:"+नाम);
        स्थिर पट: पाठ=पाठलो(मूल,"board",३२);
        स्थिर टोकन: पाठ=पाठलो(मूल,"token",६४);
        यदि (पाठ्य.लंबाई(टोकन)!=६४) { फेंको नया वेबत्रुटि(४२२,"निमंत्रण कोड अमान्य है।"); }
        प्रतीक्षा सदस्य.स्वीकारो(पट,नाम,टोकन,म,अ,चिह्न);
        लौटाओ वेब.पाठउत्तर(२०४,"");
    }
}

// Each board keeps a single high-water mark. A subscriber owns its own send.
वर्ग पटघटनाएँ {
    निजी मान नवीनतम: मानचित्र<पाठ,पूर्णांक>;
    निजी मान अधिकार: मानचित्र<पाठ,पूर्णांक>;
    निर्माता() { नवीनतम=नया मानचित्र<पाठ,पूर्णांक>(); अधिकार=नया मानचित्र<पाठ,पूर्णांक>(); }
    सार्वजनिक फलन अधिकारसंकेत(पट: पाठ) -> पूर्णांक {
        यदि (!अधिकार.है(पट)) { लौटाओ ०; }
        लौटाओ अधिकार[पट];
    }
    सार्वजनिक फलन अधिकारबदला(पट: पाठ) -> शून्य {
        अधिकार[पट]=यह.अधिकारसंकेत(पट)+१;
    }
    सार्वजनिक फलन पाओ(पट: पाठ) -> पूर्णांक {
        यदि (!नवीनतम.है(पट)) { लौटाओ ०; }
        लौटाओ नवीनतम[पट];
    }
    सार्वजनिक फलन सूचितकरो(पट: पाठ, संस्करण: पूर्णांक) -> शून्य {
        यदि (संस्करण>यह.पाओ(पट)) { नवीनतम[पट]=संस्करण; }
    }
}

वर्ग पटसॉकेट पालन वेबसॉकेटचालक {
    निजी मान घटनाएँ: पटघटनाएँ;
    निजी मान सदस्य: सदस्यभंडार;
    निर्माता(घटनाएँ: पटघटनाएँ, सदस्य: सदस्यभंडार) { यह.घटनाएँ=घटनाएँ; यह.सदस्य=सदस्य; }
    सार्वजनिक असमकालिक फलन संभालो(संदर्भ: वेबसॉकेटसंदर्भ, संबंध: वेबसॉकेटसंबंध, चिह्न: निरस्तीकरणचिह्न) -> शून्य {
        स्थिर पट: पाठ=संदर्भ.पथमान["board"];
        मान संकेत: पूर्णांक=घटनाएँ.अधिकारसंकेत(पट);
        स्थिर भूमिका: पाठ=प्रतीक्षा सदस्य.भूमिका(पट,संदर्भ.अधिकृत().उपयोगकर्ता(),चिह्न);
        यदि (भूमिका=="") {
            प्रतीक्षा संबंध.बंदकरो(१००८,""); लौटाओ;
        }
        संदर्भ.अधिकृत();
        मान भेजा: पूर्णांक=घटनाएँ.पाओ(पट);
        मान अगलीजाँच: पूर्णांक=कार्यघड़ी.अब()+५०००;
        // The client refreshes after this ready message, closing the subscribe/snapshot race.
        प्रतीक्षा संबंध.पाठभेजो("{\"v\":1,\"type\":\"ready\"}",चिह्न);
        जबतक (सत्य) {
            स्थिर संस्करण: पूर्णांक=घटनाएँ.पाओ(पट);
            स्थिर अधिकार: पूर्णांक=घटनाएँ.अधिकारसंकेत(पट);
            यदि (संस्करण>भेजा || संकेत!=अधिकार || कार्यघड़ी.अब()>=अगलीजाँच) {
                यदि ((प्रतीक्षा सदस्य.भूमिका(पट,संदर्भ.अधिकृत().उपयोगकर्ता(),चिह्न))!=भूमिका) {
                    प्रतीक्षा संबंध.बंदकरो(१००८,""); लौटाओ;
                }
                संदर्भ.अधिकृत();
                यदि (अधिकार!=घटनाएँ.अधिकारसंकेत(पट)) { जारी; }
                संकेत=अधिकार;
                अगलीजाँच=कार्यघड़ी.अब()+५०००;
            }
            यदि (संस्करण>भेजा) {
                // Only IDs from the project membership table reach this point.
                प्रतीक्षा संबंध.पाठभेजो("{\"v\":1,\"type\":\"changed\",\"board\":\""+पट+"\",\"revision\":"+वेब.अंक(संस्करण)+"}",चिह्न);
                भेजा=संस्करण;
            }
            प्रतीक्षा कार्य.विलंब(५०,चिह्न);
        }
    }
}

