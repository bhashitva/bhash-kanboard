आयात मानक.पाठ्य;
आयात मानक.वेबत्रुटि;

फलन प्रबंधननाम(मूल: मानचित्र<पाठ,सर्ववस्तु>) -> पाठ {
    स्थिर नाम: पाठ=पाठ्य.छाँटो(पाठलो(मूल,"name",८०));
    यदि (नाम=="") { फेंको नया वेबत्रुटि(४२२,"नाम चाहिए।"); }
    लौटाओ नाम;
}

फलन स्तंभबनाओ(पहचान: पूर्णांक, नाम: पाठ) -> मानचित्र<पाठ,सर्ववस्तु> {
    स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
    फल["id"]=पहचान; फल["title"]=नाम; फल["tasks"]=नया सूची<सर्ववस्तु>();
    लौटाओ फल;
}

फलन पंक्तिबनाओ(पहचान: पूर्णांक, नाम: पाठ) -> मानचित्र<पाठ,सर्ववस्तु> {
    स्थिर फल: मानचित्र<पाठ,सर्ववस्तु> = नया मानचित्र<पाठ,सर्ववस्तु>();
    फल["id"]=पहचान; फल["name"]=नाम;
    फल["columns"]=नया सूची<सर्ववस्तु>{स्तंभबनाओ(१,"करना है / To do")};
    लौटाओ फल;
}

फलन मूलपंक्तियाँ() -> सूची<सर्ववस्तु> {
    स्थिर पंक्ति: मानचित्र<पाठ,सर्ववस्तु> = पंक्तिबनाओ(१,"सामान्य / General");
    स्थिर स्तंभ: सूची<सर्ववस्तु> = आयातसूची(पंक्ति["columns"],१६);
    स्तंभ.जोड़ो(स्तंभबनाओ(२,"चल रहा है / In progress"));
    स्तंभ.जोड़ो(स्तंभबनाओ(३,"पूर्ण / Done"));
    लौटाओ नया सूची<सर्ववस्तु>{पंक्ति};
}

फलन सूचकखोजो(सूचीमान: सूची<सर्ववस्तु>, पहचान: पूर्णांक) -> पूर्णांक {
    मान सूचक: पूर्णांक=०;
    जबतक (सूचक<सूचीमान.आकार) {
        यदि (आयातअंक(आयातवस्तु(सूचीमान[सूचक])["id"],०)==पहचान) { लौटाओ सूचक; }
        सूचक=सूचक+१;
    }
    लौटाओ -१;
}

फलन लेआउटसूचक(सूचीमान: सूची<सर्ववस्तु>, पहचान: पूर्णांक) -> पूर्णांक {
    स्थिर सूचक: पूर्णांक=सूचकखोजो(सूचीमान,पहचान);
    यदि (सूचक<०) { फेंको नया वेबत्रुटि(४०४,"पंक्ति या स्तंभ नहीं मिला।"); }
    लौटाओ सूचक;
}

फलन खालीस्तंभ(स्तंभ: सर्ववस्तु) -> तार्किक {
    लौटाओ आयातसूची(आयातवस्तु(स्तंभ)["tasks"],२५०).आकार==०;
}

फलन हटानाजाँचो(प्रति: पटप्रति, प्रविष्टि: मानचित्र<पाठ,सर्ववस्तु>, पंक्ति: पूर्णांक, स्तंभ: पूर्णांक) -> शून्य {
    यदि (स्तंभ==०) {
        प्रत्येक (आयातसूची(प्रविष्टि["columns"],१६) में स: सर्ववस्तु) {
            यदि (!खालीस्तंभ(स)) { फेंको नया वेबत्रुटि(४०९,"पहले सक्रिय कार्डों का स्थान बदलें।"); }
        }
    } अन्यथा यदि (!खालीस्तंभ(प्रविष्टि)) {
        फेंको नया वेबत्रुटि(४०९,"पहले सक्रिय कार्डों का स्थान बदलें।");
    }
    प्रत्येक (प्रति.अभिलेखित में स: सर्ववस्तु) {
        स्थिर कार्ड: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(स);
        यदि (आयातअंक(कार्ड["lane"],०)==पंक्ति && (स्तंभ==० || आयातअंक(कार्ड["column"],१)==स्तंभ)) {
            फेंको नया वेबत्रुटि(४०९,"पहले संग्रहीत कार्ड वापस लाकर उनका स्थान बदलें।");
        }
    }
}

फलन लेआउटबदलो(प्रति: पटप्रति, मूल: मानचित्र<पाठ,सर्ववस्तु>) -> पाठ {
    स्थिर प्रकार: पाठ=पाठलो(मूल,"kind",६);
    स्थिर क्रिया: पाठ=पाठलो(मूल,"action",६);
    यदि (प्रकार=="board" && क्रिया=="rename") { लौटाओ प्रबंधननाम(मूल); }
    यदि (प्रकार!="lane" && प्रकार!="column") { फेंको नया वेबत्रुटि(४२२,"पंक्ति या स्तंभ चुनें।"); }
    स्थिर पंक्तिहै: तार्किक=प्रकार=="lane";
    मान पंक्ति: पूर्णांक=०;
    मान सूचीमान: सूची<सर्ववस्तु> = प्रति.पंक्तियाँ;
    यदि (!पंक्तिहै) {
        पंक्ति=चलअंक(मूल,"lane",०);
        सूचीमान=आयातसूची(आयातवस्तु(प्रति.पंक्तियाँ[लेआउटसूचक(प्रति.पंक्तियाँ,पंक्ति)])["columns"],१६);
    }
    यदि (क्रिया=="add") {
        यदि (सूचीमान.आकार>=१६) { फेंको नया वेबत्रुटि(४२२,"पंक्ति या स्तंभ सीमा पूरी है।"); }
        मान पहचान: पूर्णांक=१;
        जबतक (सूचकखोजो(सूचीमान,पहचान)>=०) { पहचान=पहचान+१; }
        स्थिर नाम: पाठ=प्रबंधननाम(मूल);
        यदि (पंक्तिहै) { सूचीमान.जोड़ो(पंक्तिबनाओ(पहचान,नाम)); }
        अन्यथा { सूचीमान.जोड़ो(स्तंभबनाओ(पहचान,नाम)); }
        लौटाओ प्रति.नाम;
    }
    स्थिर पहचान: पूर्णांक=चलअंक(मूल,"id",०);
    स्थिर सूचक: पूर्णांक=लेआउटसूचक(सूचीमान,पहचान);
    स्थिर प्रविष्टि: मानचित्र<पाठ,सर्ववस्तु> = आयातवस्तु(सूचीमान[सूचक]);
    चयन (क्रिया) {
        विकल्प "rename":
            यदि (पंक्तिहै) { प्रविष्टि["name"]=प्रबंधननाम(मूल); }
            अन्यथा { प्रविष्टि["title"]=प्रबंधननाम(मूल); }
        विकल्प "move":
            स्थिर क्रम: पूर्णांक=चलअंक(मूल,"position",१);
            यदि (क्रम>सूचीमान.आकार) { फेंको नया वेबत्रुटि(४२२,"क्रम अमान्य है।"); }
            सूचीमान.हटाओ(सूचक); सूचीमान.डालो(क्रम-१,प्रविष्टि);
        विकल्प "delete":
            यदि (सूचीमान.आकार<=१) { फेंको नया वेबत्रुटि(४०९,"एक पंक्ति और प्रत्येक पंक्ति में एक स्तंभ आवश्यक है।"); }
            यदि (पंक्तिहै) { हटानाजाँचो(प्रति,प्रविष्टि,पहचान,०); }
            अन्यथा { हटानाजाँचो(प्रति,प्रविष्टि,पंक्ति,पहचान); }
            सूचीमान.हटाओ(सूचक);
        शेष: फेंको नया वेबत्रुटि(४२२,"लेआउट बदलाव अमान्य है।");
    }
    लौटाओ प्रति.नाम;
}
